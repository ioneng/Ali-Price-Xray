{
  "manifest_version": 3,
  "name": "Ali-Price-Xray",
  "version": "0.4.0",
  "description": "Inspect the full AliExpress SKU price set behind search listings.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://aliexpress.com/*",
    "https://*.aliexpress.com/*",
    "https://aliexpress.us/*",
    "https://*.aliexpress.us/*",
    "https://*.alicdn.com/*",
    "https://*.aliexpress-media.com/*"
  ],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "scripts": [
      "background.js",
      "background-debug.js",
      "settings.js",
      "background-images.js",
      "background-sort.js",
      "background-gemini.js",
      "background-gemini-vision.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://aliexpress.com/*",
        "https://*.aliexpress.com/*",
        "https://aliexpress.us/*",
        "https://*.aliexpress.us/*"
      ],
      "js": ["content-sku-groups.js", "content.js", "content-sort.js", "content-ai.js", "content-ai-images.js", "content-sort-runtime.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ali-price-xray@ioneng",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["websiteContent", "authenticationInfo"]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
