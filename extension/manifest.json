{
  "manifest_version": 3,
  "name": "Ali-Price-Xray",
  "version": "0.3.0",
  "description": "Inspect the full AliExpress SKU price set behind search listings.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://aliexpress.com/*",
    "https://*.aliexpress.com/*",
    "https://aliexpress.us/*",
    "https://*.aliexpress.us/*",
    "https://*.alicdn.com/*",
    "https://*.aliexpress-media.com/*"
  ],
  "background": {
    "scripts": ["background.js", "background-images.js", "background-sort.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://aliexpress.com/*",
        "https://*.aliexpress.com/*",
        "https://aliexpress.us/*",
        "https://*.aliexpress.us/*"
      ],
      "js": ["content.js", "content-sort.js", "content-sort-runtime.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ali-price-xray@ioneng",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
